# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Core API
POS_API_BIND=127.0.0.1:8787
POS_API_ALLOWED_ORIGINS=http://localhost:5173

# Optional OIDC / ZITADEL identity (all or none)
POS_API_OIDC_ISSUER=
POS_API_OIDC_INTROSPECTION_URL=
POS_API_OIDC_API_AUDIENCE=
POS_API_OIDC_ALLOWED_CLIENT_IDS=
# Path to the ZITADEL private-key JSON file. Keep this file outside the repo
# or in a gitignored location; never commit it.
POS_API_OIDC_KEY_FILE=

# Optional operator service auth. Enable with docker-compose.operator-auth.yml,
# using a separate OIDC application and a distinct operator API audience/client.
# Keep the signing key file outside the repository.
# POS_OPERATOR_OIDC_ISSUER=https://identity.example
# POS_OPERATOR_OIDC_INTROSPECTION_URL=https://identity.example/oauth/v2/introspect
# POS_OPERATOR_OIDC_API_AUDIENCE=https://operator-api.example
# POS_OPERATOR_OIDC_ALLOWED_CLIENT_IDS=advanced-pos-operator-console
# POS_OPERATOR_OIDC_KEY_FILE=C:/Users/your-name/.secrets/operator-key.json

# Database (server-only; never ship in client/installer)
POS_API_DATABASE_URL=
POS_API_MIGRATION_DATABASE_URL=
