# Copy to .env (gitignored) and fill in locally. Never commit real values.
# Core API
POS_API_BIND=127.0.0.1:8787
POS_API_ALLOWED_ORIGINS=http://localhost:5173

# Optional OIDC / ZITADEL identity (all or none)
POS_API_OIDC_ISSUER=
POS_API_OIDC_INTROSPECTION_URL=
POS_API_OIDC_API_AUDIENCE=
POS_API_OIDC_ALLOWED_CLIENT_IDS=
# Path to the ZITADEL private-key JSON file. Keep this file outside the repo
# or in a gitignored location; never commit it.
POS_API_OIDC_KEY_FILE=

# Database (server-only; never ship in client/installer)
POS_API_DATABASE_URL=
POS_API_MIGRATION_DATABASE_URL=
# Dedicated worker login; never share with the API or migration process.
POS_API_EXPIRY_DATABASE_URL=
POS_API_ATTENDANCE_DATABASE_URL=

# Separate operator service (server-only; separate IdP application and database login)
POS_OPERATOR_BIND=127.0.0.1:8788
POS_OPERATOR_ALLOWED_ORIGINS=http://localhost:5174
POS_OPERATOR_OIDC_ISSUER=
POS_OPERATOR_OIDC_INTROSPECTION_URL=
POS_OPERATOR_OIDC_API_AUDIENCE=
POS_OPERATOR_OIDC_ALLOWED_CLIENT_IDS=
POS_OPERATOR_OIDC_KEY_FILE=
POS_OPERATOR_FORBIDDEN_AUDIENCES=
POS_OPERATOR_FORBIDDEN_CLIENT_IDS=
POS_OPERATOR_DATABASE_URL=
POS_OPERATOR_PROVISIONING_DATABASE_URL=
POS_OPERATOR_PROVISIONING_ACTOR=

# Local Compose only. Override in an ignored .env before starting the stack.
POS_API_DEV_OPERATOR_PASSWORD=local-operator-only
POS_API_DEV_OPERATOR_PROVISIONER_PASSWORD=local-operator-provisioner-only
POS_API_DEV_EXPIRY_RUNNER_PASSWORD=local-expiry-runner-only
POS_API_DEV_ATTENDANCE_RUNNER_PASSWORD=local-attendance-runner-only
